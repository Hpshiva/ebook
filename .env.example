# Copy this file to ".env" (same folder) and fill in what you need.
# Everything is optional: with no values the app runs in free demo mode.

# Apify API token. Only needed for live Instagram profile collection.
# Get it from https://console.apify.com → Settings → API & Integrations.
APIFY_TOKEN=

# Signing key for login sessions. If empty, one is generated and stored in backend/data/.secret_key.
# Set a long random value in production (for example: openssl rand -base64 48).
SECRET_KEY=

# Database. Default is a local SQLite file. For production use PostgreSQL, e.g.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/creator_finder
DATABASE_URL=

# Browser origins allowed to call the API (only needed when frontend and backend are on different hosts).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Login session length in minutes.
TOKEN_MINUTES=720
